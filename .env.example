# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Custom backend API
API_BASE_URL=https://api.yourdomain.com
API_TIMEOUT_MS=15000

# Google Sign-In (Google Cloud Console > Credentials > OAuth Web client ID)
# Must also be added as a provider in Supabase Auth > Providers > Google.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Apple Sign-In (only needed for the Android/web fallback flow; iOS uses the
# native capability instead). Set up a Services ID in Apple Developer and
# add it as a provider in Supabase Auth > Providers > Apple.
APPLE_SERVICE_ID=com.yourcompany.momflex.signin
APPLE_REDIRECT_URI=https://your-project.supabase.co/auth/v1/callback
